[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ManufacturerName%
CatalogFile = CrossView.cat
DriverVer   = 09/13/2026,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
crossview.sys = 1,,

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%CrossView.DeviceDesc% = CrossView_Install, Root\CrossView

[CrossView_Install.NT]
CopyFiles = Drivers_Dir

[Drivers_Dir]
crossview.sys

[CrossView_Install.NT.Services]
AddService = CrossView,0x00000002,CrossView_Service

[CrossView_Service]
DisplayName    = %CrossView.SVCDESC%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\crossview.sys

[Strings]
ManufacturerName     = "CROSSVIEW Lab"
DiskName             = "CROSSVIEW Installation Disk"
CrossView.DeviceDesc = "CROSSVIEW Kernel Integrity Scanner"
CrossView.SVCDESC    = "CROSSVIEW detection-only driver"
